{
  "name": "portfolio",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "libs/*"
  ],
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "build:libs": "npm run build --workspace libs/types && npm run build --workspace libs/utils && npm run build --workspace libs/mocks",
    "build:web": "npm run build --workspace apps/web",
    "build": "npm run build:libs && npm run build:web",
    "dev": "npm run build:libs && npm run dev:web",
    "dev:web": "npm run dev --workspace apps/web",
    "serve": "npm run serve --workspace apps/web",
    "lint": "npm run lint --workspaces --if-present",
    "lint:fix": "npm run lint:fix --workspaces --if-present",
    "format": "prettier --write \"{apps,libs}/**/*.{ts,tsx,js,jsx,json,md,css}\"",
    "test": "npm run test --workspaces --if-present",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.1",
    "@commitlint/config-conventional": "21.2.0",
    "husky": "9.1.7",
    "lint-staged": "17.2.0",
    "prettier": "3.9.6",
    "prettier-plugin-tailwindcss": "0.8.1"
  }
}
